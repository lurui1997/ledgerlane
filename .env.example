# Copy to .env if you want local overrides. Docker Compose already sets mock mode.

DATABASE_URL=postgresql://acmg:acmg@localhost:54329/acmg
# DATABASE_URL=memory

ACMG_AUTH_MODE=demo
ACMG_DEMO_TOKEN=demo-shopper-token
ACMG_DEMO_CLIENT_ID=demo-client
ACMG_DEMO_CLIENT_SECRET=demo-secret

LLM_PROVIDER=mock
# LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-flash

PAYMENT_PROVIDER=mock
# PAYMENT_PROVIDER=paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

PUBLIC_BASE_URL=http://localhost:4317
MCP_INTERNAL_URL=http://127.0.0.1:4317/mcp
HOST=0.0.0.0
PORT=4317
